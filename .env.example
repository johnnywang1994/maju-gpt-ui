# Server-side OpenAI-compatible API configuration. For OpenRouter use:
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
# Comma-separated allowlist for the model picker. OPENAI_MODEL must be included.
OPENAI_MODELS=gpt-5.4,gpt-5.4-mini,gpt-5.6-sol,gpt-5.6-luna,gpt-5.6-terra,google/gemini-3.5-flash-lite,google/gemini-3.8-flash,google/gemini-3.5-flash,google/gemini-2.5-flash
# Comma-separated subset of OPENAI_MODELS that may receive images.
OPENAI_VISION_MODELS=gpt-5.4,gpt-5.4-mini,gpt-5.6-sol,gpt-5.6-luna,gpt-5.6-terra,google/gemini-3.5-flash-lite,google/gemini-3.8-flash,google/gemini-3.5-flash,google/gemini-2.5-flash

# Comma-separated allowlist for image generation. Leaving this empty hides image mode.
OPENAI_IMAGE_MODELS=openai/gpt-image-1-mini
# Optional dedicated key; falls back to OPENAI_API_KEY.
OPENAI_IMAGE_API_KEY=
# Server-only image generation endpoint (OpenRouter default shown).
OPENAI_IMAGE_GENERATIONS_URL=https://openrouter.ai/api/v1/images

# Images: one JPEG/PNG/WebP/HEIC per request; original and compressed payloads
# are limited to 4 MiB. HEIC is converted to JPEG client-side. Image bytes are
# sent only for the request and are never saved in browser chat sessions.

# Optional LIFF access-token validation.
NEXT_PUBLIC_ENABLE_AUTH=false
NEXT_PUBLIC_LIFF_ID=
LINE_CHANNEL_ID=

# Default system prompt pre-filled in the settings. Supports variables such as
# {currentTime}; leave empty to use the built-in default.
NEXT_PUBLIC_DEFAULT_SYSTEM_PROMPT=
# IANA timezone used to render {currentTime}. Leave empty to use the server timezone.
SYSTEM_PROMPT_TIMEZONE=
